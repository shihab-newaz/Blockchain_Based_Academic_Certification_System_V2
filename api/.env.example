PORT=3001
WEB_ORIGIN=http://localhost:3000

# AES key used to encrypt the IPFS CID stored on-chain — generate a real
# random secret for any non-local environment.
AES_SECRET_KEY=change-me

# Local Kubo/IPFS Desktop daemon HTTP API
IPFS_URL=http://127.0.0.1:5001

# Fabric network (infra/fabric/test-network) — Org1 = UniversityOrg (issuer),
# Org2 = VerifierOrg. Paths below assume api/ and infra/ are sibling
# directories under the repo root.
FABRIC_CHANNEL_NAME=certchannel
FABRIC_CHAINCODE_NAME=certcc
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_TLS_CERT_PATH=../infra/fabric/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
FABRIC_CERT_PATH=../infra/fabric/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/signcerts/cert.pem
FABRIC_KEY_DIRECTORY_PATH=../infra/fabric/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/keystore

# Issuer auth (single seeded credential for v1 — see docs/plan Phase 4a).
# Generate ISSUER_PASSWORD_HASH with: node -e "require('bcrypt').hash('<password>',10).then(console.log)"
ISSUER_USERNAME=admin
ISSUER_PASSWORD_HASH=change-me
JWT_SECRET=change-me
JWT_EXPIRES_IN=2h
